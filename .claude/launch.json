{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lacet-front",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "lacet-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "cwd": "frontend",
      "port": 4173,
      "url": "http://localhost:4173"
    },
    {
      "name": "lacet-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "lacet-ipa",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765"
      ],
      "cwd": ".",
      "port": 8765
    }
  ]
}
