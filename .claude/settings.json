{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/*.ipa)",
      "Read(//**/node_modules/**)",
      "Read(//**/frontend/dist/**)",
      "Read(//**/frontend/ios/**)",
      "Read(//**/frontend/public/region/**)",
      "Read(//**/backend/.venv/**)",
      "Read(//**/backend/.cache/**)",
      "Read(//**/__pycache__/**)",
      "Read(//**/.pytest_cache/**)",
      "Read(//**/frontend/package-lock.json)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Bash(rtk read *)"
    ]
  }
}
