.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
# Tous les .env, pas seulement celui du backend : celui du front peut
# contenir un jeton Mapbox, et un dépôt public ne pardonne pas.
.env
.env.*
!.env.example

node_modules/
dist/
.vite/

.DS_Store
Thumbs.db

# Projet iOS : régénéré à chaque compilation (voir .github/workflows/ios.yml)
frontend/ios/
frontend/android/
*.ipa

# Carte régionale : produite par la compilation (scripts/region_tiles.py), jamais versionnée.
frontend/public/region/

# Le dossier servi à AltStore : la source, qui porte l’adresse du PC sur le
# réseau local, l’icône et les copies versionnées de l’IPA. Il se régénère
# (scripts/altstore_source.py) et n’a rien à faire dans le dépôt.
altstore/
