{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "back: tests",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m pytest",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "back: smoke",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe scripts/smoke.py ${input:ville} ${input:distance}",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "front: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "lacet"
      }
    },
    {
      "label": "front: tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Lacet — tous les tests",
      "dependsOn": [
        "back: tests",
        "front: tests"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }

  ],
  "inputs": [
    {
      "id": "ville",
      "type": "pickString",
      "description": "Ville de test",
      "options": [
        "paris",
        "lyon",
        "toulouse",
        "annecy"
      ],
      "default": "paris"
    },
    {
      "id": "distance",
      "type": "promptString",
      "description": "Distance en kilomètres",
      "default": "10"
    }
  ]
}
