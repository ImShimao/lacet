# Copie ce fichier en `.env` pour surcharger la configuration.
# Toutes les valeurs ci-dessous sont les valeurs par défaut.

# Fournisseur d'altitude : ign (France, 1-5 m) | opentopodata (monde, 25-30 m) | none
LACET_ELEVATION_PROVIDER=ign
LACET_ELEVATION_FALLBACK=opentopodata

# Un point d'altitude tous les N mètres le long du tracé.
LACET_ELEVATION_SAMPLE_M=50

# Seuil d'hystérésis du D+ (modèle fin, après lissage) : sans lui, le bruit du
# MNT gonfle le dénivelé ; trop haut, il rabote les côtes. Voir `elevation.py`.
LACET_ASCENT_THRESHOLD_M=1.0

# Nombre de directions explorées autour du départ, et de boucles brutes gardées
# avant filtrage. Ce sont aussi les réglages du moteur de l'app
# (`frontend/src/engine/service.js`) : s'en écarter ici, c'est comparer les deux
# moteurs sur des recherches différentes.
LACET_SECTORS=16
LACET_MAX_CANDIDATES=32

# Durée de vie du cache OSM sur disque, en jours.
LACET_CACHE_TTL_DAYS=14
