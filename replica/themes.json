{
  "_about": "Thèmes des avis d'apps de course et d'itinéraires (anglais et français), pour reviews.py --themes.",
  "request_patterns": [
    "\\bi wish\\b", "\\bplease (add|make|bring|fix|let)\\b", "\\bwould (be|love)\\b", "\\bneeds? (a|an|the|to|more)\\b",
    "\\bno way to\\b", "\\bthere'?s no (way|option)\\b", "\\b(missing|lacks|lacking)\\b", "\\bif only\\b",
    "\\bfeature request\\b", "\\bwhy (can'?t|isn'?t|doesn'?t)\\b", "\\bcan'?t (add|choose|set|change|edit|pick)\\b",
    "\\bj'aimerais\\b", "\\bj’aimerais\\b", "\\bil manque\\b", "\\bmanque\\b", "\\bce serait (bien|top|super|génial)\\b",
    "\\bça serait\\b", "\\bserait (bien|top|super|génial|pratique)\\b", "\\bdommage\\b", "\\bpourquoi (ne pas|pas)\\b",
    "\\bpossibilité de\\b", "\\bpouvoir\\b", "\\bsvp\\b", "\\bs'il vous plaît\\b"
  ],
  "themes": [
    {"id": "loop_shape", "label": "Boucles ratées : aller-retour, repassages, zigzags", "kind": "complaint",
     "patterns": ["\\bout.and.back\\b", "\\bback and forth\\b", "\\bsame (road|street|path) (twice|back)", "\\bzig.?zag", "\\bnot a (real )?loop\\b", "\\baller.retour", "\\brepass", "\\bmême (rue|chemin|route)", "\\bdemi.tour", "\\bweird (route|loop)", "\\bstrange (route|loop)", "\\bnonsense\\b", "\\bpointless\\b", "\\bpas une boucle\\b", "\\bincohérent"]},
    {"id": "distance", "label": "Distance demandée non tenue", "kind": "complaint",
     "patterns": ["\\b(too|way) (long|short)\\b", "\\b(longer|shorter) than\\b", "\\bdistance (is|was|wrong|off)\\b", "\\bwrong distance\\b", "\\bkm de (plus|trop|moins)\\b", "\\btrop (long|court)", "\\bplus long que\\b", "\\bdistance (fausse|erronée|pas respectée)", "\\bne respecte pas"]},
    {"id": "unsafe", "label": "Routes dangereuses, sans trottoir, trop de voitures", "kind": "complaint",
     "patterns": ["\\bbusy road", "\\bmain road", "\\bhighway", "\\bmotorway", "\\bdangerous\\b", "\\bunsafe\\b", "\\bno (sidewalk|pavement|footpath)\\b", "\\btraffic\\b", "\\bdangereu", "\\bnationale\\b", "\\bdépartementale\\b", "\\btrottoir", "\\bvoitures?\\b", "\\bcirculation\\b", "\\bsécuris", "\\bsafe(ty|r)?\\b"]},
    {"id": "bad_paths", "label": "Chemins privés, fermés, inexistants, impasses", "kind": "complaint",
     "patterns": ["\\bprivate\\b", "\\bprivé", "\\bclosed\\b", "\\bfermé", "\\bfence", "\\bclôtur", "\\bdead.?end", "\\bimpasse", "\\bdoesn'?t exist\\b", "\\bn'existe (pas|plus)", "\\bn’existe (pas|plus)", "\\bno path\\b", "\\bthrough (a |someone'?s )?(field|farm|yard|property)", "\\bchamp\\b", "\\bpropriété", "\\bbarri"]},
    {"id": "voice", "label": "Guidage vocal : absent, trop tard, faux, trop bavard", "kind": "complaint",
     "patterns": ["\\bvoice\\b", "\\baudio\\b", "\\bturn.by.turn\\b", "\\bdirections?\\b", "\\binstructions?\\b", "\\bannounce", "\\bvoix\\b", "\\bvocal", "\\bguidage\\b", "\\bindications?\\b", "\\bconsignes?\\b"]},
    {"id": "reroute", "label": "Hors parcours, recalcul, se perdre", "kind": "complaint",
     "patterns": ["\\breroute", "\\bre-route", "\\brecalcul", "\\boff.?(route|course|track)\\b", "\\bhors (parcours|trac)", "\\bgot lost\\b", "\\bget lost\\b", "\\bperdu", "\\bégaré", "\\bmissed (a |the )?turn"]},
    {"id": "background", "label": "Écran verrouillé, arrière-plan, suivi qui s'arrête", "kind": "complaint",
     "patterns": ["\\bbackground\\b", "\\block(ed)? screen\\b", "\\bscreen (lock|off)\\b", "\\bstops? (tracking|recording|working)\\b", "\\bpaus(e|es|ed)\\b", "\\bverrouill", "\\barrière.plan", "\\bs'arrête\\b", "\\bse met en pause\\b", "\\bcoupe\\b"]},
    {"id": "battery", "label": "Batterie", "kind": "complaint",
     "patterns": ["\\bbattery\\b", "\\bbatterie\\b", "\\bdrain"]},
    {"id": "gps", "label": "GPS imprécis, distance enregistrée fausse", "kind": "complaint",
     "patterns": ["\\bgps\\b", "\\baccura", "\\bprécis", "\\bjump", "\\bsaute\\b"]},
    {"id": "offline", "label": "Hors ligne, sans réseau", "kind": "request",
     "patterns": ["\\boffline\\b", "\\bno (signal|reception|service|data)\\b", "\\bhors.?ligne", "\\bsans (réseau|connexion)", "\\bréseau\\b"]},
    {"id": "export", "label": "Export GPX, montre, Garmin, Strava, Apple Watch", "kind": "request",
     "patterns": ["\\bgpx\\b", "\\bgarmin\\b", "\\bwatch\\b", "\\bmontre\\b", "\\bcoros\\b", "\\bsuunto\\b", "\\bwahoo\\b", "\\bsync", "\\bexport", "\\bimport", "\\bstrava\\b", "\\bhealth\\b", "\\bsanté\\b"]},
    {"id": "paywall", "label": "Fonctions passées en payant, abonnement", "kind": "complaint",
     "patterns": ["\\bpaywall", "\\bsubscri", "\\bpremium\\b", "\\bpay(ing)? for\\b", "\\bmoney\\b", "\\bprice\\b", "\\bexpensive\\b", "\\babonnement", "\\bpayant", "\\bpayer\\b", "\\bcher\\b", "\\bgratuit"]},
    {"id": "variety", "label": "Toujours les mêmes boucles, peu de choix", "kind": "complaint",
     "patterns": ["\\bsame (route|routes|loop|loops)\\b", "\\brepetitive\\b", "\\bregenerat", "\\bnew route", "\\bvariety\\b", "\\btoujours les mêmes\\b", "\\bmêmes parcours\\b", "\\bvariété\\b", "\\bautres? parcours\\b", "\\bplus de (choix|parcours)\\b"]},
    {"id": "elevation", "label": "Dénivelé : profil, plat, côtes", "kind": "request",
     "patterns": ["\\belevation\\b", "\\bhills?\\b", "\\bhilly\\b", "\\bflat\\b", "\\bclimb", "\\bdénivel", "\\bcôtes?\\b", "\\bplat\\b", "\\bmontée"]},
    {"id": "surface", "label": "Terrain : sentier, route, surface", "kind": "request",
     "patterns": ["\\btrails?\\b", "\\bgravel\\b", "\\bsurface\\b", "\\bmud", "\\bdirt\\b", "\\bpaved\\b", "\\bsentier", "\\bchemin", "\\bterrain\\b", "\\bgoudron", "\\bbitume"]},
    {"id": "control", "label": "Contrôle : points de passage, modifier, éviter une zone, direction", "kind": "request",
     "patterns": ["\\bwaypoint", "\\bedit(ing)? (the |a )?route", "\\bdrag", "\\bavoid\\b", "\\bdirection\\b", "\\bcustomi", "\\bdraw", "\\bpoints? de passage", "\\bmodifier\\b", "\\béviter\\b", "\\bpersonnalis", "\\bchoisir\\b"]},
    {"id": "start_point", "label": "Point de départ : maison, autre lieu, retour", "kind": "request",
     "patterns": ["\\bstart(ing)? (point|location|from)\\b", "\\bfrom (my )?(home|house|door)\\b", "\\bpoint de départ\\b", "\\bdépart\\b", "\\bretour\\b", "\\bback home\\b", "\\bbring me back\\b"]},
    {"id": "night", "label": "Nuit, éclairage, sécurité perçue", "kind": "request",
     "patterns": ["\\bnight\\b", "\\bat dark\\b", "\\blit\\b", "\\blighting\\b", "\\bstreet ?lights?\\b", "\\bnuit\\b", "\\béclair", "\\bwomen\\b", "\\bfemme"]},
    {"id": "sos", "label": "SOS, partage de position en direct", "kind": "request",
     "patterns": ["\\bsos\\b", "\\bemergency\\b", "\\blive ?track", "\\bbeacon\\b", "\\bshare (my )?location\\b", "\\burgence\\b", "\\bpartage de position\\b"]},
    {"id": "poi", "label": "Points d'eau, toilettes, points d'intérêt", "kind": "request",
     "patterns": ["\\bwater\\b", "\\bfountain", "\\btoilet", "\\brestroom", "\\bbathroom", "\\bpoints? d'(eau|intérêt)", "\\bfontaine", "\\btoilettes?\\b", "\\bpoi\\b", "\\blandmark"]},
    {"id": "ui", "label": "Interface confuse, carte illisible", "kind": "complaint",
     "patterns": ["\\bconfus", "\\bhard to (use|find|read|see)\\b", "\\bcomplicated\\b", "\\bcluttered\\b", "\\bunintuitive\\b", "\\bnot intuitive\\b", "\\bclunky\\b", "\\bcompliqu", "\\bpas intuiti", "\\billisible", "\\bergonom", "\\bfont size\\b", "\\bdark mode\\b", "\\bmode sombre\\b"]},
    {"id": "bugs", "label": "Bugs et plantages", "kind": "complaint",
     "patterns": ["\\bcrash", "\\bbugs?\\b", "\\bbuggy\\b", "\\bglitch", "\\bfreez", "\\bbroken\\b", "\\b(doesn'?t|does not|stopped) work", "\\bnot working\\b", "\\bplant", "\\bbeug", "\\bne (marche|fonctionne) (pas|plus)\\b", "\\bbloqu"]},
    {"id": "updates", "label": "Une mise à jour ou refonte a empiré les choses", "kind": "complaint",
     "patterns": ["\\b(new|latest|recent|last) (update|version|design)\\b", "\\bredesign", "\\bused to\\b", "\\bbring back\\b", "\\bsince the update\\b", "\\bmise à jour\\b", "\\bdepuis la (mise|maj|dernière)", "\\bavant c'était\\b", "\\bnouvelle version\\b"]}
  ]
}
